// The rules this project holds itself to, by name, so the standards document can point at
// them. Type-aware on purpose: the ones that catch real bugs here — a promise nobody awaits,
// a switch that stopped being exhaustive when a union grew — need types, and a linter that
// cannot see them only finds formatting.
//
// Every category is off and each rule below is named, the way the eslint config before it was
// explicit: `recommendedTypeChecked`'s `no-unsafe-*` family fires on every `JSON.parse`, and
// validating a payload by checking its fields is what this code does on purpose.
{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [],
	"categories": { "correctness": "off" },
	"options": { "typeAware": true },
	"overrides": [
		{
			"files": ["src/**/*.ts", "test/**/*.ts"],
			"plugins": ["typescript"],
			"rules": {
				// Promises: every one is awaited, returned, or explicitly ignored with `void`.
				"typescript/no-floating-promises": "error",
				"typescript/no-misused-promises": "error",
				"typescript/await-thenable": "error",
				// A union that grows must break the switch that switches on it.
				"typescript/switch-exhaustiveness-check": "error",
				// Types at the edges: `any` is not allowed; `unknown` plus a check is the way.
				"typescript/no-explicit-any": "error",
				// Complexity and size, at the same bar as the Go side (#102). `warn` while the queue is
				// not empty: a gate that is red from the day it lands is one nobody runs, and `oxlint`
				// only fails on errors. These become errors when the worker is brought to the bar.
				"complexity": ["warn", 15],
				"max-lines": ["warn", { "max": 600, "skipComments": true, "skipBlankLines": true }],
				"max-lines-per-function": ["warn", { "max": 60, "skipComments": true, "skipBlankLines": true }],
				"typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
				"typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
				// Listed to record the decision: `!` is how this code states what it just checked.
				"typescript/no-non-null-assertion": "off",
				"eqeqeq": ["error", "smart"],
				"prefer-const": "error",
				"no-var": "error"
			}
		}
	]
}
